import PSTSEPPA.ABO.CayleyStageProjection

/-!
# Corrected ABO 4.7(ii): the concrete signed-word endpoint test for a G-stage cover

The existing stage-cover embedding API takes a pointwise equality
`F(g) = original tagged H-multiCE vertex` for every actual selected
G-attached coset point `g`. For the historical §5 construction the
natural evidence consists instead of ACTUAL signed paths/word
endpoints inside a completed stage, rather than a priori
pointwise equality of quotient vertices.

The two elementary theorems in this file give a precise,
CHECKABLE bridge. Every genuine labelled Cayley(G)→T
morphism, based at its actual image of group identity,
sends the G-value of a signed word w to the endpoint of
the REAL signed stage word path w. If G is generated by
its selected letters, checking the stage endpoint of the
canonical representative word of a point g is EQUIVALENT
to checking F(g).

The signed word convention, formal inverse edge orientations
and trivial-generator loops are inherited from the accepted
`CompleteEGraph.hom_followWord`, not replaced by an
abstract unlabelled reachability claim.

This lemma does NOT invent the source required cover of
every H full-B-augmented coset extension; it isolates
precisely the word-path computation that must be verified
in that construction.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ V Edge : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]

namespace CompleteEGraph

variable (T : CompleteEGraph V Edge ι)

/-- ACTUAL labelled signed Cayley-to-stage maps send the G-value
of any signed word to its true positive/inverse stage endpoint
from the original image of the identity. No group generation,
surjectivity, stage connectivity or injectivity is assumed. -/
theorem cayleyHom_on_signedWordValue
    (gen : ι → Γ)
    (F : LabelledGraphHom
      (cayleyGraph gen).toEGraph.toLabelledGraph
      T.toEGraph.toLabelledGraph)
    (w : LabelWord ι) :
    F.onVertex (PSTS.SignedWord.evalGroup gen w) =
      T.followWord (F.onVertex (1 : Γ)) w := by
  have hCayley :
      (cayleyGraph gen).followWord (1 : Γ) w =
        PSTS.SignedWord.evalGroup gen w := by
    simpa using
      (cayleyGraph.followWord_eq_mul_evalGroup gen (1 : Γ) w)
  have hMap :
      T.followWord (F.onVertex (1 : Γ)) w =
        F.onVertex ((cayleyGraph gen).followWord 1 w) :=
    CompleteEGraph.hom_followWord (cayleyGraph gen) T F 1 w
  calc
    F.onVertex (PSTS.SignedWord.evalGroup gen w) =
        F.onVertex ((cayleyGraph gen).followWord 1 w) :=
      congrArg F.onVertex hCayley.symm
    _ = T.followWord (F.onVertex (1 : Γ)) w :=
      hMap.symm

/-- Under generatedness, the ACTUAL stage image of any G-point
is determined by the signed path from F(1) with the
canonical representative word of that G-point. -/
theorem cayleyHom_on_wordRep
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (F : LabelledGraphHom
      (cayleyGraph gen).toEGraph.toLabelledGraph
      T.toEGraph.toLabelledGraph)
    (g : Γ) :
    F.onVertex g =
      T.followWord (F.onVertex (1 : Γ))
        (wordRep gen hgen g) := by
  calc
    F.onVertex g =
      F.onVertex (PSTS.SignedWord.evalGroup gen
        (wordRep gen hgen g)) := by simp
    _ = T.followWord (F.onVertex (1 : Γ))
          (wordRep gen hgen g) :=
      T.cayleyHom_on_signedWordValue gen F (wordRep gen hgen g)

/-- A stage word-ENDPOINT certificate is exactly as strong as
the desired pointwise ORIGINAL tagged stage representation,
for every represented G group element. All formal inverse
signed letters are preserved in the endpoint equality. -/
theorem cayleyHom_represents_iff_wordRep
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (F : LabelledGraphHom
      (cayleyGraph gen).toEGraph.toLabelledGraph
      T.toEGraph.toLabelledGraph)
    (g : Γ) (v : V) :
    F.onVertex g = v ↔
      T.followWord (F.onVertex (1 : Γ))
        (wordRep gen hgen g) = v := by
  rw [T.cayleyHom_on_wordRep gen hgen F g]

/-- A REAL signed-word certificate with explicit G-value
and stage endpoint forces the pointwise stage equality.
Useful when the source stage construction produces
signed paths but not canonical representative words. -/
theorem cayleyHom_represents_of_signedWordPath
    (gen : ι → Γ)
    (F : LabelledGraphHom
      (cayleyGraph gen).toEGraph.toLabelledGraph
      T.toEGraph.toLabelledGraph)
    (g : Γ) (v : V)
    (hPath : ∃ w : LabelWord ι,
      PSTS.SignedWord.evalGroup gen w = g ∧
      T.followWord (F.onVertex (1 : Γ)) w = v) :
    F.onVertex g = v := by
  obtain ⟨w, hw, hEnd⟩ := hPath
  calc
    F.onVertex g =
      F.onVertex (PSTS.SignedWord.evalGroup gen w) :=
      congrArg F.onVertex hw.symm
    _ = T.followWord (F.onVertex (1 : Γ)) w :=
      T.cayleyHom_on_signedWordValue gen F w
    _ = v := hEnd

end CompleteEGraph
end ABO
end PSTSEPPA
