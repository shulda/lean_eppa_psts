import PSTSEPPA.ABO.UniversalStageFiniteTransport
import PSTSEPPA.ABO.UniversalStageRealCayleyCover
import PSTSEPPA.ABO.SynchronizedGeneratedGroup

/-!
# Every finite kernel-correct stage action factors through the universal group

The bounded universal permutation catalogue (#337–#339), the actual
Cayley covers of its tagged components (#340), and the transport
of arbitrary finite completed stages into Fin n (#346) together
imply a precise structural statement:

  If two signed words represent the SAME element in the actual
  synchronously generated universal group, then following those
  words from ANY vertex of EVERY finite completed stage T with
  the required size and rank-k kernel yields identical endpoints.

The proof retains the genuine tag of T in the dependent
disjoint action and uses the TRUE second group projection
of the universal generated group. It does not assume that
T already embeds in an ambient Cayley graph, nor identify
distinct tagged coset-extension quotient points by their
ambient group values.

This is the algebraic well-definedness statement required to
construct canonical graph covers from the universal group onto
source-completed stages. The source-specific size and historical
word-kernel conditions remain independent obligations.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ V Edge : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]
variable [Fintype V]

/-- The ACTUAL generated universal action group is generated by
the same positive labels as the ambient original group and each
of its complete finite permutation stage coordinates. -/
theorem universalStageGenerator_isGenerated
    (gen : ι → Γ) (k M : ℕ) :
    IsGenerated (universalStageGenerator gen k M) :=
  SynchronizedProduct.generator_isGenerated gen
    (boundedKernelAllSizesStage gen k M).transitionSubgroupGenerator

/-- Universal-group word equality is reflected at EVERY vertex
of ANY finite source-completed E-graph whose real action meets
the rank-k word-kernel and carrier-size bound.

This compares actual completed signed-word endpoints, not just
their projected Γ-values. No generation or finiteness of Γ is
needed for this equality; the catalogue carrier is already finite. -/
theorem universalStage_wordEquality_reflects_completedStage
    (gen : ι → Γ) (k M : ℕ)
    (T : CompleteEGraph V Edge ι)
    (hsize : Fintype.card V ≤ M)
    (hkernel :
      ∀ (C : Finset ι), C.card ≤ k →
        ∀ (w : LabelWord ι), LabelWord.Uses C w →
          PSTS.SignedWord.evalGroup gen w = 1 →
            T.wordValue w = 1)
    (p q : LabelWord ι)
    (hpq :
      PSTS.SignedWord.evalGroup (universalStageGenerator gen k M) p =
      PSTS.SignedWord.evalGroup (universalStageGenerator gen k M) q)
    (u : V) :
    T.followWord u p = T.followWord u q := by
  classical
  let e : V ≃ Fin (Fintype.card V) := Fintype.equivFin V
  let U := boundedKernelAllSizesStage gen k M
  let j : boundedKernelAllSizesIndex gen k M :=
    exactStageCatalogueEntry gen k M (Fintype.card V)
      T e hsize hkernel
  have hProj :
      PSTS.SignedWord.evalGroup U.transitionSubgroupGenerator p =
      PSTS.SignedWord.evalGroup U.transitionSubgroupGenerator q := by
    calc
      PSTS.SignedWord.evalGroup U.transitionSubgroupGenerator p =
          SynchronizedProduct.sndHom gen U.transitionSubgroupGenerator
            (PSTS.SignedWord.evalGroup
              (SynchronizedProduct.generator gen
                U.transitionSubgroupGenerator) p) :=
        (SynchronizedProduct.sndHom_evalGroup
          gen U.transitionSubgroupGenerator p).symm
      _ = SynchronizedProduct.sndHom gen U.transitionSubgroupGenerator
            (PSTS.SignedWord.evalGroup
              (SynchronizedProduct.generator gen
                U.transitionSubgroupGenerator) q) := by
        exact congrArg
          (SynchronizedProduct.sndHom gen U.transitionSubgroupGenerator)
          hpq
      _ = PSTS.SignedWord.evalGroup U.transitionSubgroupGenerator q :=
        SynchronizedProduct.sndHom_evalGroup
          gen U.transitionSubgroupGenerator q
  have hPerm : U.wordValue p = U.wordValue q := by
    have hcoercion :=
      congrArg
        (fun g : U.transitionGroup =>
          (g : RightPerm (boundedKernelAllSizesVertex gen k M)))
        hProj
    exact (U.evalGroup_transitionSubgroupGenerator_val p).symm.trans
      (hcoercion.trans (U.evalGroup_transitionSubgroupGenerator_val q))
  have hFollow :
      U.followWord
        (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) p =
      U.followWord
        (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) q := by
    calc
      U.followWord
          (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) p =
        CompleteEGraph.rightApply (U.wordValue p)
          (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) :=
        (U.rightApply_wordValue p _).symm
      _ = CompleteEGraph.rightApply (U.wordValue q)
          (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) := by
        rw [hPerm]
      _ = U.followWord
          (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) q :=
        U.rightApply_wordValue q _
  have hp :
      U.followWord
        (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) p =
      (⟨j, e (T.followWord u p)⟩ :
        boundedKernelAllSizesVertex gen k M) := by
    exact exactStageCatalogueEntry_followWord
      gen k M (Fintype.card V) T e hsize hkernel u p
  have hq :
      U.followWord
        (⟨j, e u⟩ : boundedKernelAllSizesVertex gen k M) q =
      (⟨j, e (T.followWord u q)⟩ :
        boundedKernelAllSizesVertex gen k M) := by
    exact exactStageCatalogueEntry_followWord
      gen k M (Fintype.card V) T e hsize hkernel u q
  rw [hp, hq] at hFollow
  have heq :
      e (T.followWord u p) = e (T.followWord u q) :=
    eq_of_heq (Sigma.mk.inj_iff.mp hFollow).2
  exact e.injective heq

/-- A source-facing vertexwise version: equality of universal
group words acts identically not just at a chosen root, but
simultaneously at EVERY original vertex of the completed stage. -/
theorem universalStage_wordEquality_all_completed_vertices
    (gen : ι → Γ) (k M : ℕ)
    (T : CompleteEGraph V Edge ι)
    (hsize : Fintype.card V ≤ M)
    (hkernel :
      ∀ (C : Finset ι), C.card ≤ k →
        ∀ (w : LabelWord ι), LabelWord.Uses C w →
          PSTS.SignedWord.evalGroup gen w = 1 →
            T.wordValue w = 1)
    (p q : LabelWord ι)
    (hpq :
      PSTS.SignedWord.evalGroup (universalStageGenerator gen k M) p =
      PSTS.SignedWord.evalGroup (universalStageGenerator gen k M) q) :
    ∀ u : V, T.followWord u p = T.followWord u q := by
  intro u
  exact universalStage_wordEquality_reflects_completedStage
    gen k M T hsize hkernel p q hpq u

end ABO
end PSTSEPPA
