import PSTSEPPA.ABO.SourceLiteralY1ThreeKindTransitionQuotient
import PSTSEPPA.ABO.SynchronizedStageStableCover
import PSTSEPPA.ABO.SynchronizedGeneratedGroup

/-!
# Genuine printed first-rank three-kind synchronisation and repaired k=1 stability

The old source H₁ is input-derived, finite, two-retractable and
generator-labelled; it is canonically isomorphic to the literal
paper T(Y₁). The second factor here is NOT a surrogate X₁-completed
old graph: it is the actual printed original-edge, signed and LEGALLY
completed all-choice three-kind stage action from the certified
first-rank construction.

Synchronise the true H₁ generator with the actual transition
generator of that printed complete stage. The resulting group
projects onto H₁ and the stage's genuine transition group.

The repaired Proposition 5.4 base-case kernel statement holds:
every H₁-trivial signed word with at most one positive generator
label acts trivially on EVERY stage vertex. This follows from
the already certified G₂ -> H₁ one-stability and the exact
word-action congruence for ALL three printed stage types.
Consequently the real synchronous quotient to H₁ is 1-stable,
the new group is 2-retractable and finite.

This verifies the algebraic rank-one base for the REDUNDANT
all-choice printed stage family. It does NOT yet construct an
equivariantly selected exact Definition-5.3 Z₁ or prove
Condition 5.2, Theorem 4.7, higher-rank induction, the final
reflecting group or unconditional PSTS EPPA.
-/

namespace PSTSEPPA
namespace ABO

variable {ι V : Type*}
variable [Fintype ι] [DecidableEq ι]
variable [Fintype V] [DecidableEq V]

/-- The actual generated synchronous group of H₁ and the
three-kind genuinely PRINTED complete first-rank stage action. -/
noncomputable abbrev sourceLiteralY1PaperStageSynchronousGroup
    (src dst : ι → V) :=
  SynchronizedProduct.stageCover
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst)

/-- Genuine synchronized letters, including the same signed
word orientation on the full old/fresh completed action. -/
noncomputable abbrev sourceLiteralY1PaperStageSynchronousGenerator
    (src dst : ι → V) :=
  SynchronizedProduct.generator
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst).transitionSubgroupGenerator

/-- The combined first-rank group is generated by exactly
the original input edge-label alphabet. -/
theorem sourceLiteralY1PaperStageSynchronous_isGenerated
    (src dst : ι → V) :
    IsGenerated (sourceLiteralY1PaperStageSynchronousGenerator src dst) :=
  SynchronizedProduct.generator_isGenerated
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst).transitionSubgroupGenerator

/-- Actual surjective labelled projection of the synchronous
paper-stage group onto the source H₁ factor. -/
noncomputable def sourceLiteralY1PaperStageSynchronousToH1
    (src dst : ι → V) :
    LabelledGroupQuotient
      (sourceLiteralY1PaperStageSynchronousGenerator src dst)
      (sourceH1Generator src dst) :=
  SynchronizedProduct.stageCoverQuotient
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst)
    (sourceH1Generator_isGenerated src dst)

/-- The other coordinate is genuinely onto the transition
group of the ACTUAL printed complete three-kind stages. -/
noncomputable def sourceLiteralY1PaperStageSynchronousToTransition
    (src dst : ι → V) :
    LabelledGroupQuotient
      (sourceLiteralY1PaperStageSynchronousGenerator src dst)
      (sourceLiteralY1ThreeKindStage src dst).transitionSubgroupGenerator :=
  SynchronizedProduct.sndQuotient
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst).transitionSubgroupGenerator
    (sourceLiteralY1ThreeKindStage src dst).transitionSubgroupGenerator_isGenerated

/-- Corrected ABO Proposition-5.4 FIRST RANK, for this
ENTIRE actual printed three-kind superfamily: an arbitrary
chronological signed word on <=1 generator vanishing in H₁
fixes ALL vertices of all the legal completed stages. The
proof uses the concrete finite G₂, not a false ambient-value
identification or a rank-zero induction hypothesis. -/
theorem sourceLiteralY1ThreeKind_rankOne_stageKernel
    (src dst : ι → V)
    (C : Finset ι) (hC : C.card ≤ 1)
    (w : LabelWord ι) (hw : LabelWord.Uses C w)
    (hDown :
      PSTS.SignedWord.evalGroup (sourceH1Generator src dst) w = 1) :
    (sourceLiteralY1ThreeKindStage src dst).wordValue w = 1 := by
  have hUp :
      PSTS.SignedWord.evalGroup
        (sourceAllLocalG2Generator src dst) w = 1 :=
    ((sourceAllLocalG2ToH1 src dst).kStable_iff_word_kernel 1).mp
      (sourceAllLocalG2ToH1_oneStable src dst)
        C hC w hw hDown
  apply ((sourceLiteralY1ThreeKindStage src dst).wordValue_eq_one_iff_all_vertices_fixed w).mpr
  intro u
  have hG2 :
      PSTS.SignedWord.evalGroup (sourceAllLocalG2Generator src dst) w =
        PSTS.SignedWord.evalGroup
          (sourceAllLocalG2Generator src dst) ([] : LabelWord ι) := by
    simpa using hUp
  have hFollow :=
    sourceG2LiteralY1ThreeKind_wordValue_congr src dst
      w [] hG2 u
  simpa using hFollow

/-- Genuine rank-one stability of the actual finite
H₁ x PRINTED-three-kind-stage synchronous action group.
This is the direct repaired base of the Section-5
inductive stability gate, still in all-choice scope. -/
theorem sourceLiteralY1PaperStageSynchronousToH1_oneStable
    (src dst : ι → V) :
    (sourceLiteralY1PaperStageSynchronousToH1 src dst).KStable 1 :=
  SynchronizedProduct.stageCoverQuotient_kStable_of_stageKernel
    (sourceH1Generator src dst)
    (sourceLiteralY1ThreeKindStage src dst)
    (sourceH1Generator_isGenerated src dst)
    1
    (sourceLiteralY1ThreeKind_rankOne_stageKernel src dst)

/-- The repaired retractability descent applies to the
actual printed all-choice first-rank synchronous group:
1-stability over 2-retractable H₁ implies 2-retractability. -/
theorem sourceLiteralY1PaperStageSynchronous_twoRetractable
    (src dst : ι → V) :
    KRetractable (sourceLiteralY1PaperStageSynchronousGenerator src dst) 2 := by
  exact
    (sourceLiteralY1PaperStageSynchronousToH1 src dst).kRetractable_of_kStable
      1
      (sourceLiteralY1PaperStageSynchronousToH1_oneStable src dst)
      (sourceH1_twoRetractable src dst)

/-- The actual printed rank-one group is finite, because
both H₁ and the exact all-choice printed three-kind transition
group are finite. No finite-index assumption or ambient
coordinate collapse is required for this argument. -/
theorem finite_sourceLiteralY1PaperStageSynchronousGroup
    (src dst : ι → V) :
    Finite (sourceLiteralY1PaperStageSynchronousGroup src dst) := by
  classical
  letI : Finite (SourceH1 src dst) := finite_sourceH1 src dst
  letI : Finite (sourceLiteralY1ThreeKindStage src dst).transitionGroup :=
    finite_sourceLiteralY1ThreeKindTransitionGroup src dst
  letI : Fintype (SourceH1 src dst) := Fintype.ofFinite _
  letI : Fintype
      (sourceLiteralY1ThreeKindStage src dst).transitionGroup :=
    Fintype.ofFinite _
  infer_instance

end ABO
end PSTSEPPA
