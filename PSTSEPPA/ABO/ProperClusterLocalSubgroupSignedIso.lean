import PSTSEPPA.ABO.ClusterCayleySkeleton
import PSTSEPPA.ABO.LocalSubgroupCosetNaturality
import PSTSEPPA.ABO.LocalCosetCayleySlice

/-!
# ABO 4.5: ACTUAL signed proper B-clusters in H[C] and ambient Γ

The source locally applies the full forward induction in the
globally retractable labelled subgroup H[C]. The resulting
proper B-clusters (B⊆C) are concrete unions of generated
D-subgroups for strictly smaller D⊊B, with real positive
and negative oriented signed edge tokens.

It is NOT enough to know that the source B-component and its
local H[C] counterpart have abstract isomorphic signed graphs:
to recover the precise SOURCE translated proper B-cluster in
Γ, the local proper B-cluster itself must map to the SAME
concrete ambient Γ cluster, preserving both signed edge tokens.

Here we prove for ANY Γ, ANY B⊆C and ANY family P of
proper B-subalphabets (including empty family), the following:
* local and ambient constituent subgroup and signed-edge
  memberships are EXACTLY equivalent;
* all ambient proper cluster vertices/edges genuinely lie in
  the subgroup generated by C;
* inclusion H[C] ↪ Γ induces an honest equivalence of
  all actual proper-cluster vertices and signed oriented edges;
* these maps form a bijective LABELLED GRAPH MORPHISM,
  preserving formal reversal, source and signed labels.

No global retractability, group generation, completeness of
old skeletons, equality-by-ambient-coset quotient, new axioms
or sorry is used. This is specifically the concrete proper
cluster-shape transfer needed after the source signed B-component
isomorphism and minimum-tagged-support localization.
-/

namespace PSTSEPPA
namespace ABO
namespace ClusterSpec

variable {ι Γ : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]
variable {B : Finset ι}

/-- Exact vertex-set equivalence of an actual proper
B-cluster in the generated parent H[C] and its original
ambient Γ-cluster, for EVERY B⊆C. -/
theorem localVertexSet_parent_iff_ambient
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C)
    (x : generatedSubgroup gen C) :
    x ∈ P.VertexSet (trivialCompletionGenerator gen C) ↔
      (x : Γ) ∈ P.VertexSet gen := by
  constructor
  · rintro ⟨D, hDP, hx⟩
    exact ⟨D, hDP,
      (mem_localGeneratedSubgroup_iff_ambient
        gen D C ((P.proper D hDP).subset.trans hBC) x).mp hx⟩
  · rintro ⟨D, hDP, hx⟩
    exact ⟨D, hDP,
      (mem_localGeneratedSubgroup_iff_ambient
        gen D C ((P.proper D hDP).subset.trans hBC) x).mpr hx⟩

/-- Exact oriented signed EDGE membership of a proper
B-cluster in H[C] and in Γ, including BOTH signs of each
label and repeated/trivial generators. -/
theorem localEdgeSet_parent_iff_ambient
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C)
    (x : generatedSubgroup gen C) (s : SignedLabel ι) :
    ((x, s) : ActionEdge (generatedSubgroup gen C) ι) ∈
        P.EdgeSet (trivialCompletionGenerator gen C) ↔
      (((x : Γ), s) : ActionEdge Γ ι) ∈ P.EdgeSet gen := by
  change
    (∃ D ∈ P.pieces,
      x ∈ generatedSubgroup (trivialCompletionGenerator gen C) D ∧
        signedBase s ∈ D) ↔
    (∃ D ∈ P.pieces,
      (x : Γ) ∈ generatedSubgroup gen D ∧
        signedBase s ∈ D)
  constructor
  · rintro ⟨D, hDP, hx, hs⟩
    exact ⟨D, hDP,
      (mem_localGeneratedSubgroup_iff_ambient
        gen D C ((P.proper D hDP).subset.trans hBC) x).mp hx, hs⟩
  · rintro ⟨D, hDP, hx, hs⟩
    exact ⟨D, hDP,
      (mem_localGeneratedSubgroup_iff_ambient
        gen D C ((P.proper D hDP).subset.trans hBC) x).mpr hx, hs⟩

/-- Every vertex of the concrete Γ proper B-cluster
actually belongs to the larger generated subgroup Γ[C].
This holds even when Γ is not globally generated. -/
theorem vertex_mem_parentSubgroup
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C)
    (x : Γ) (hx : x ∈ P.VertexSet gen) :
    x ∈ generatedSubgroup gen C := by
  obtain ⟨D, hDP, hxD⟩ := hx
  exact generatedSubgroup_mono gen
    ((P.proper D hDP).subset.trans hBC) hxD

/-- Full vertex equivalence, not mere equality of ambient
coordinates, between the signed local/ambient proper B-clusters. -/
noncomputable def localVertexEquivOfParent
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) :
    P.Vertex (trivialCompletionGenerator gen C) ≃
      P.Vertex gen where
  toFun x :=
    ⟨(x.1 : Γ),
      (P.localVertexSet_parent_iff_ambient gen C hBC x.1).mp x.2⟩
  invFun x :=
    ⟨(⟨x.1, P.vertex_mem_parentSubgroup gen C hBC x.1 x.2⟩ :
      generatedSubgroup gen C),
      (P.localVertexSet_parent_iff_ambient gen C hBC
        ⟨x.1, P.vertex_mem_parentSubgroup gen C hBC x.1 x.2⟩).mpr x.2⟩
  left_inv := by
    intro x
    apply Subtype.ext
    apply Subtype.ext
    rfl
  right_inv := by
    intro x
    apply Subtype.ext
    rfl

/-- The matching equivalence of literal oriented signed
edge TOKENS. The ambient edge's old source is proved to
belong to Γ[C], so no illegitimate inverse of Γ[C]↪Γ
is invoked on arbitrary ambient elements. -/
noncomputable def localEdgeEquivOfParent
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) :
    P.Edge (trivialCompletionGenerator gen C) ≃
      P.Edge gen where
  toFun e :=
    ⟨(((e.1.1 : Γ), e.1.2) : ActionEdge Γ ι),
      (P.localEdgeSet_parent_iff_ambient
        gen C hBC e.1.1 e.1.2).mp e.2⟩
  invFun e :=
    let x : generatedSubgroup gen C :=
      ⟨e.1.1, P.vertex_mem_parentSubgroup
        gen C hBC e.1.1 (P.edge_source_mem gen e.2)⟩
    ⟨((x, e.1.2) : ActionEdge (generatedSubgroup gen C) ι),
      (P.localEdgeSet_parent_iff_ambient
        gen C hBC x e.1.2).mpr e.2⟩
  left_inv := by
    intro e
    apply Subtype.ext
    apply Prod.ext
    · apply Subtype.ext
      rfl
    · rfl
  right_inv := by
    intro e
    apply Subtype.ext
    rfl

/-- ACTUAL source/ambient signed labelled graph morphism
for the entire proper B-cluster, constructed by literal
inclusion of local Γ[C] coordinates and true oriented edge
tokens. It is not a graph map obtained by freely
completing the original missing Cayley edges. -/
noncomputable def localSignedClusterHomOfParent
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) :
    LabelledGraphHom
      (P.toLabelledGraph (trivialCompletionGenerator gen C))
      (P.toLabelledGraph gen) where
  onVertex := P.localVertexEquivOfParent gen C hBC
  onEdge := P.localEdgeEquivOfParent gen C hBC
  map_source e := by
    apply Subtype.ext
    rfl
  map_inv e := by
    apply Subtype.ext
    have hs : signedBase e.1.2 ∈ C := by
      rcases e.2 with ⟨D, hDP, _, hl⟩
      exact ((P.proper D hDP).subset.trans hBC) hl
    change
      (((((cayleyGraph (trivialCompletionGenerator gen C)).inv e.1).1 : Γ),
        ((cayleyGraph (trivialCompletionGenerator gen C)).inv e.1).2) :
          ActionEdge Γ ι) =
        (cayleyGraph gen).inv ((e.1.1 : Γ), e.1.2)
    simpa only [one_mul] using
      (localCayley_inv_leftTranslate gen C (1 : Γ) e.1 hs)
  map_label e := rfl

/-- The local H[C] to original ambient Γ graph morphism
is BIJECTIVE on ALL genuine proper B-cluster vertices AND
all oriented signed edge tokens. It preserves the signed
label, source, inverse and therefore target as well. -/
theorem localSignedClusterHomOfParent_bijective
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) :
    Function.Bijective
      (P.localSignedClusterHomOfParent gen C hBC).onVertex ∧
    Function.Bijective
      (P.localSignedClusterHomOfParent gen C hBC).onEdge :=
  ⟨(P.localVertexEquivOfParent gen C hBC).bijective,
   (P.localEdgeEquivOfParent gen C hBC).bijective⟩

end ClusterSpec
end ABO
end PSTSEPPA
