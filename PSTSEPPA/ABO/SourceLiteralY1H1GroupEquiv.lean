import PSTSEPPA.ABO.SourceLiteralY1ToH1WordKernel
import PSTSEPPA.ABO.LabelledWordKernelMulEquiv
import PSTSEPPA.ABO.TransitionGroupGenerated

/-!
# Source H₁ is genuinely the printed T(Y₁), as a labelled group

The literal source graph Y₁ was constructed with exactly the full
X₁ action and one separately tagged complete regular Cayley action
of the actual G₁[{i}] for each generator i. Its transition group
is the genuine T(Y₁) appearing in corrected ABO Section 5.

The previous two-sided kernel theorem shows that the actual
source-shaped synchronized H₁ and literal T(Y₁) have identical
chronological signed identity-word kernels for ALL words, not
just words on a bounded alphabet. Both groups are generated by
the positive input letters. The generic labelled-kernel theorem
therefore produces a genuine GROUP ISOMORPHISM, not a chosen
point-set bijection or an abstract presumed transfer map.

We also verify that it sends every actual input generator to the
same-labelled generator in T(Y₁), including repeated/trivial letters,
and therefore preserves the evaluations of all signed words.
This discharges the first-rank printed H₁=T(Y₁) ALGEBRAIC
presentation interface, conditional only on the prior kernel
lemmas which themselves must pass independent full Lean CI.

It does not prove that all printed selected Z₁ stages are precisely
the constructed source three-kind supercatalogue, nor corrected
Condition 5.2, Theorem 4.7, later historical Yₖ/Zₖ or PSTS EPPA.
-/

namespace PSTSEPPA
namespace ABO

variable {ι V : Type*}
variable [Fintype ι] [DecidableEq ι]
variable [Fintype V] [DecidableEq V]

/-- The FULL identity-signed-word-kernel equivalence of the
generated H₁ and literal paper T(Y₁) positive-label families.
In particular no relation beyond the actual singleton detector
relations and X₁ relations was added by the synchronized model. -/
theorem sourceH1_literalY1_transition_kernel_iff
    (src dst : ι → V) (w : LabelWord ι) :
    PSTS.SignedWord.evalGroup (sourceH1Generator src dst) w = 1 ↔
      PSTS.SignedWord.evalGroup
        (sourceLiteralY1 src dst).transitionSubgroupGenerator w = 1 := by
  have hTransition :
      PSTS.SignedWord.evalGroup
        (sourceLiteralY1 src dst).transitionSubgroupGenerator w = 1 ↔
      (sourceLiteralY1 src dst).wordValue w = 1 := by
    constructor
    · intro h
      have hv := congrArg Subtype.val h
      exact
        ((sourceLiteralY1 src dst).evalGroup_transitionSubgroupGenerator_val w).symm.trans
          hv
    · intro h
      apply Subtype.ext
      exact
        ((sourceLiteralY1 src dst).evalGroup_transitionSubgroupGenerator_val w).trans h
  exact (sourceLiteralY1_wordValue_eq_one_iff_sourceH1
    src dst w).symm.trans hTransition.symm

/-- ACTUAL canonical labelled-group isomorphism, directly
addressing the paper's literal transition group H₁=T(Y₁).
The old abstract unary synchronized group SourceH₁ is now
identified without changing its source-labelled generators. -/
noncomputable def sourceH1EquivLiteralY1Transition
    (src dst : ι → V) :
    SourceH1 src dst ≃*
      (sourceLiteralY1 src dst).transitionGroup :=
  labelledWordKernelMulEquiv
    (sourceH1Generator src dst)
    (sourceLiteralY1 src dst).transitionSubgroupGenerator
    (sourceH1Generator_isGenerated src dst)
    ((sourceLiteralY1 src dst).transitionSubgroupGenerator_isGenerated)
    (sourceH1_literalY1_transition_kernel_iff src dst)

/-- The canonical H₁=T(Y₁) isomorphism is strictly
GENERATOR-PRESERVING on every positive original edge label,
including original loops and nonfaithful generator maps. -/
@[simp] theorem sourceH1EquivLiteralY1Transition_generator
    (src dst : ι → V) (i : ι) :
    sourceH1EquivLiteralY1Transition src dst
        (sourceH1Generator src dst i) =
      (sourceLiteralY1 src dst).transitionSubgroupGenerator i := by
  exact labelledWordKernelMulEquiv_generator
    (sourceH1Generator src dst)
    (sourceLiteralY1 src dst).transitionSubgroupGenerator
    (sourceH1Generator_isGenerated src dst)
    ((sourceLiteralY1 src dst).transitionSubgroupGenerator_isGenerated)
    (sourceH1_literalY1_transition_kernel_iff src dst) i

/-- Consequence: exact chronological signed-word values are
respected by the printed-H₁ isomorphism (including every
formal inverse edge token). -/
theorem sourceH1EquivLiteralY1Transition_evalGroup
    (src dst : ι → V) (w : LabelWord ι) :
    sourceH1EquivLiteralY1Transition src dst
      (PSTS.SignedWord.evalGroup (sourceH1Generator src dst) w) =
    PSTS.SignedWord.evalGroup
      (sourceLiteralY1 src dst).transitionSubgroupGenerator w := by
  let Q := sourceH1EquivLiteralY1Transition src dst
  induction w with
  | nil => simp
  | cons s w ih =>
      cases s with
      | pos i =>
          change Q
              (sourceH1Generator src dst i *
                PSTS.SignedWord.evalGroup (sourceH1Generator src dst) w) =
              (sourceLiteralY1 src dst).transitionSubgroupGenerator i *
                PSTS.SignedWord.evalGroup
                  (sourceLiteralY1 src dst).transitionSubgroupGenerator w
          rw [map_mul, sourceH1EquivLiteralY1Transition_generator, ih]
      | neg i =>
          change Q
              ((sourceH1Generator src dst i)⁻¹ *
                PSTS.SignedWord.evalGroup (sourceH1Generator src dst) w) =
              ((sourceLiteralY1 src dst).transitionSubgroupGenerator i)⁻¹ *
                PSTS.SignedWord.evalGroup
                  (sourceLiteralY1 src dst).transitionSubgroupGenerator w
          rw [map_mul, map_inv,
            sourceH1EquivLiteralY1Transition_generator, ih]

end ABO
end PSTSEPPA
