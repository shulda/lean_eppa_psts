import PSTSEPPA.ABO.RetractabilityRetraction
import PSTSEPPA.ABO.SynchronizedStageStableCover
import PSTSEPPA.ABO.CayleyStageProjection

/-!
# Signed-word congruence yields a genuine labelled-group action and Cayley graph cover

Suppose a labelled group Γ is genuinely generated by its ι-letters
and a complete signed EGraph T satisfies the EXACT following-word
condition: equality of values of arbitrary chronological signed
words in Γ implies equality of their actions on every T-vertex.

A representative word for g∈Γ therefore has a uniquely determined
transition permutation of T. This gives a REAL generator-preserving
group homomorphism Γ → Transition(T), not just an existence of a
pointwise set map or a comparison of ambient coordinates.

Using the certified source-exact canonical group-to-stage Cayley
projection, this constructs an actual signed labelled graph morphism
Cayley(Γ) → T based at EVERY vertex. Its image of each word value
is the exact completed signed word endpoint, including inverse
letters and stationary loops.

This is a generic full-cover construction interface for the
original H₁ source rank-one completed Z₁ stages controlled by
the ACTUAL finite G₂. It needs NO injectivity of the projection,
no ambient group coordinate equality of distinct quotient vertices,
no arbitrary group freeness and no extra retractability premise.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ V Edge : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]

namespace CompleteEGraph

variable (T : CompleteEGraph V Edge ι)

/-- A complete stage's universal signed word-action congruence
implies equality of its actual transition subgroup word values,
including negative labels and both inverse tokens at loops. -/
theorem transitionWordValue_eq_of_groupWordActionCongr
    (gen : ι → Γ)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q)
    (p q : LabelWord ι)
    (hpq : PSTS.SignedWord.evalGroup gen p =
      PSTS.SignedWord.evalGroup gen q) :
    PSTS.SignedWord.evalGroup T.transitionSubgroupGenerator p =
      PSTS.SignedWord.evalGroup T.transitionSubgroupGenerator q := by
  have hPerm :
      MulOpposite.unop (T.wordValue p) =
      MulOpposite.unop (T.wordValue q) := by
    apply Equiv.ext
    intro x
    calc
      MulOpposite.unop (T.wordValue p) x =
        T.followWord x p := T.rightApply_wordValue p x
      _ = T.followWord x q := hcongr p q hpq x
      _ = MulOpposite.unop (T.wordValue q) x :=
        (T.rightApply_wordValue q x).symm
  apply Subtype.ext
  calc
    ((PSTS.SignedWord.evalGroup
        T.transitionSubgroupGenerator p : T.transitionGroup) : RightPerm V) =
      T.wordValue p := T.evalGroup_transitionSubgroupGenerator_val p
    _ = T.wordValue q := congrArg MulOpposite.op hPerm
    _ = ((PSTS.SignedWord.evalGroup
        T.transitionSubgroupGenerator q : T.transitionGroup) : RightPerm V) :=
      (T.evalGroup_transitionSubgroupGenerator_val q).symm

/-- The actual, uniquely well-defined labelled transition-group
homomorphism from Γ, derived from the signed-word action congruence.
Uses representative words only for construction, not as an additional
axiom or as an arbitrary choice at stage vertices. -/
noncomputable def groupWordActionHom
    (gen : ι → Γ)
    (hgen : IsGenerated gen)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q) :
    Γ →* T.transitionGroup where
  toFun g :=
    PSTS.SignedWord.evalGroup T.transitionSubgroupGenerator
      (wordRep gen hgen g)
  map_one' := by
    have hsource :
        PSTS.SignedWord.evalGroup gen (wordRep gen hgen 1) =
          PSTS.SignedWord.evalGroup gen ([] : LabelWord ι) := by simp
    have h :=
      T.transitionWordValue_eq_of_groupWordActionCongr
        gen hcongr (wordRep gen hgen 1) [] hsource
    simpa using h
  map_mul' g h := by
    have hsource :
        PSTS.SignedWord.evalGroup gen (wordRep gen hgen (g * h)) =
          PSTS.SignedWord.evalGroup gen
            (wordRep gen hgen g ++ wordRep gen hgen h) := by simp
    have heq :=
      T.transitionWordValue_eq_of_groupWordActionCongr
        gen hcongr (wordRep gen hgen (g * h))
        (wordRep gen hgen g ++ wordRep gen hgen h) hsource
    simpa [PSTS.SignedWord.evalGroup_append] using heq

/-- The well-defined homomorphism preserves the same positive
distinguished labelled generator, even for repeated/identity labels. -/
@[simp] theorem groupWordActionHom_generator
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q)
    (i : ι) :
    T.groupWordActionHom gen hgen hcongr (gen i) =
      T.transitionSubgroupGenerator i := by
  have hsource :
      PSTS.SignedWord.evalGroup gen (wordRep gen hgen (gen i)) =
        PSTS.SignedWord.evalGroup gen [PSTS.SignedLetter.pos i] := by simp
  have heq :=
    T.transitionWordValue_eq_of_groupWordActionCongr
      gen hcongr (wordRep gen hgen (gen i))
      [PSTS.SignedLetter.pos i] hsource
  simpa [groupWordActionHom] using heq

/-- An ACTUAL labelled Cayley graph morphism from Γ to the
complete stage T, not merely well-defined endpoint values.
It is based at any chosen vertex and respects the true oriented
signed edges, inverse letters and fixed-point loops. -/
noncomputable def cayleyCoverFromWordCongruence
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q)
    (u : V) :
    LabelledGraphHom
      (cayleyGraph gen).toEGraph.toLabelledGraph
      T.toEGraph.toLabelledGraph :=
  T.cayleyProjectionFromGroup gen
    (T.groupWordActionHom gen hgen hcongr)
    (T.groupWordActionHom_generator gen hgen hcongr) u

/-- The genuine Cayley cover is rooted at the requested completed
stage vertex, without any injectivity or connectedness hypothesis. -/
@[simp] theorem cayleyCoverFromWordCongruence_one
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q)
    (u : V) :
    (T.cayleyCoverFromWordCongruence gen hgen hcongr u).onVertex 1 = u :=
  T.cayleyProjectionFromGroup_one gen
    (T.groupWordActionHom gen hgen hcongr)
    (T.groupWordActionHom_generator gen hgen hcongr) u

/-- The image of the *actual group value* of ANY chronological
signed word is EXACTLY the same path endpoint in the complete
stage, not just equality of ambient group coordinates. -/
theorem cayleyCoverFromWordCongruence_word
    (gen : ι → Γ) (hgen : IsGenerated gen)
    (hcongr :
      ∀ (p q : LabelWord ι),
        PSTS.SignedWord.evalGroup gen p =
          PSTS.SignedWord.evalGroup gen q →
        ∀ x : V, T.followWord x p = T.followWord x q)
    (u : V) (w : LabelWord ι) :
    (T.cayleyCoverFromWordCongruence gen hgen hcongr u).onVertex
      (PSTS.SignedWord.evalGroup gen w) =
      T.followWord u w :=
  T.cayleyProjectionFromGroup_evalGroup gen
    (T.groupWordActionHom gen hgen hcongr)
    (T.groupWordActionHom_generator gen hgen hcongr) u w

end CompleteEGraph
end ABO
end PSTSEPPA
