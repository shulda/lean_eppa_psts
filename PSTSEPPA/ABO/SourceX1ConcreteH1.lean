import PSTSEPPA.ABO.UnaryH1RankTwoTower
import PSTSEPPA.ABO.TransitionGroupGenerated
import PSTSEPPA.ABO.StageStabilityWordKernel
import Mathlib.Logic.Equiv.Basic

/-!
# A concrete source-shaped first group H1 from original oriented edge endpoints

The corrected ABO source begins with an arbitrary finite oriented
edge-labelled graph, with each positive generator equal to ONE
original oriented edge. Its first complete action X1 makes that
label act as the transposition of the edge's endpoints (or as the
identity for a geometric loop), fixing every other original vertex.

Here the edge alphabet ι is finite, the vertex set V is finite,
and src,dst : ι → V specify those exact original endpoints.
The first transition group G1 is the ACTUAL subgroup of
Perm(V)^op generated by these transpositions.

Synchronizing G1 with its true unary cyclic detectors produces
a finite generated group H1 with a genuine 1-stable quotient
onto G1, 2-retractability, and -- crucially -- EXACTLY the
necessary first-rank period behavior: nonloop generators square
to the identity, and loop generators are literally identity.

This formalizes a concrete initial group model rather than
assuming an arbitrary H1 satisfying involutivity. It does not
yet identify this synchronized model with the source's literal
T(Y1) complete-graph presentation, or construct the full Y1/Z1
source catalogue and the reflecting group.
-/

namespace PSTSEPPA
namespace ABO

variable {ι V : Type*} [Fintype ι] [DecidableEq ι]
variable [Fintype V] [DecidableEq V]

/-- Source first complete E-graph: the original label e acts by
swapping its actual endpoints, fixing all other vertices.
Geometric loops act as identity; parallel labelled edges remain
separate labels. -/
noncomputable def sourceX1
    (src dst : ι → V) :
    CompleteEGraph V (ActionEdge V ι) ι :=
  actionGraph (fun i => Equiv.swap (src i) (dst i))

/-- Its true generated transition-group positive letters. -/
noncomputable abbrev sourceG1Generator
    (src dst : ι → V) :
    ι → (sourceX1 src dst).transitionGroup :=
  (sourceX1 src dst).transitionSubgroupGenerator

/-- The genuine G1 is generated by its original edge letters.
No fictitious relation or freeness assumption is introduced. -/
theorem sourceG1Generator_isGenerated
    (src dst : ι → V) :
    IsGenerated (sourceG1Generator src dst) :=
  (sourceX1 src dst).transitionSubgroupGenerator_isGenerated

/-- Each exact source transposition (and each loop identity)
has square one in the ACTUAL transition subgroup of X1. -/
theorem sourceG1Generator_sq
    (src dst : ι → V) (i : ι) :
    (sourceG1Generator src dst i) ^ 2 = 1 := by
  have hswap :
      (Equiv.swap (src i) (dst i) : Equiv.Perm V) ^ 2 = 1 := by
    apply Equiv.ext
    intro x
    simpa [pow_two] using
      (Equiv.swap_apply_self (src i) (dst i) x)
  apply Subtype.ext
  change (sourceX1 src dst).transitionGenerator i ^ 2 =
    (1 : RightPerm V)
  change
    (actionGraph (fun j => Equiv.swap (src j) (dst j))).
      transitionGenerator i ^ 2 = (1 : RightPerm V)
  rw [actionGraph.transitionGenerator]
  apply MulOpposite.unop_injective
  exact hswap

/-- For an original geometric loop the source X1 generator
is literally identity, not merely an involution. -/
theorem sourceG1Generator_loop
    (src dst : ι → V) (i : ι)
    (hloop : src i = dst i) :
    sourceG1Generator src dst i = 1 := by
  apply Subtype.ext
  change (sourceX1 src dst).transitionGenerator i =
    (1 : RightPerm V)
  change
    (actionGraph (fun j => Equiv.swap (src j) (dst j))).
      transitionGenerator i = (1 : RightPerm V)
  rw [actionGraph.transitionGenerator]
  rw [hloop]
  simp

/-- The ACTUAL generated synchronous group of the source X1
transition group with its own cyclic detector coordinates. -/
noncomputable abbrev SourceH1
    (src dst : ι → V) :=
  UnarySynchronizedCover (sourceG1Generator src dst)

/-- Its true positive generator map, retaining the original
edge-label alphabet, including geometric loops. -/
noncomputable abbrev sourceH1Generator
    (src dst : ι → V) :
    ι → SourceH1 src dst :=
  unaryH1Generator (sourceG1Generator src dst)

/-- The source-shaped H1 has its original edge letters as
an actually generating set. -/
theorem sourceH1Generator_isGenerated
    (src dst : ι → V) :
    IsGenerated (sourceH1Generator src dst) :=
  unaryH1Generator_isGenerated (sourceG1Generator src dst)

/-- The concrete source-shaped H1 is 2-retractable, even
though the original X1 transition group is not globally
retractable in general (e.g. two incident transpositions). -/
theorem sourceH1_twoRetractable
    (src dst : ι → V) :
    KRetractable (sourceH1Generator src dst) 2 :=
  unarySynchronizedCover_twoRetractable (sourceG1Generator src dst)

/-- The genuine labelled first-coordinate quotient H1→G1
is rank-one stable; it is produced from the actual generated
groups, not assumed. -/
theorem sourceH1ToG1_oneStable
    (src dst : ι → V) :
    (unarySynchronizedCoverQuotient
      (sourceG1Generator src dst)
      (sourceG1Generator_isGenerated src dst)).KStable 1 :=
  unarySynchronizedCoverQuotient_oneStable
    (sourceG1Generator src dst)
    (sourceG1Generator_isGenerated src dst)

/-- Because H1→G1 is 1-stable, the two-letter positive word
ii that vanishes in the original transposition group ALSO
vanishes in the genuinely constructed source-shaped H1.
This proves actual H1 involutivity, not a detector-only
statement. -/
theorem sourceH1Generator_sq
    (src dst : ι → V) (i : ι) :
    (sourceH1Generator src dst i) ^ 2 = 1 := by
  let Q :=
    unarySynchronizedCoverQuotient
      (sourceG1Generator src dst)
      (sourceG1Generator_isGenerated src dst)
  have hDown :
      PSTS.SignedWord.evalGroup
        (sourceG1Generator src dst)
        [PSTS.SignedLetter.pos i, PSTS.SignedLetter.pos i] = 1 := by
    simpa [PSTS.SignedWord.evalGroup, pow_two] using
      sourceG1Generator_sq src dst i
  have hUp :=
    ((Q.kStable_iff_word_kernel 1).mp
      (sourceH1ToG1_oneStable src dst))
      ({i} : Finset ι) (by simp)
      [PSTS.SignedLetter.pos i, PSTS.SignedLetter.pos i]
      (by simp [LabelWord.Uses]) hDown
  simpa [PSTS.SignedWord.evalGroup, pow_two] using hUp

/-- Source geometric loops stay literal identity generators
in H1. Rank-one stability is essential to this implication;
surjectivity alone would not exclude a new kernel element. -/
theorem sourceH1Generator_loop
    (src dst : ι → V) (i : ι)
    (hloop : src i = dst i) :
    sourceH1Generator src dst i = 1 := by
  let Q :=
    unarySynchronizedCoverQuotient
      (sourceG1Generator src dst)
      (sourceG1Generator_isGenerated src dst)
  have hDown :
      PSTS.SignedWord.evalGroup
        (sourceG1Generator src dst)
        [PSTS.SignedLetter.pos i] = 1 := by
    simpa [PSTS.SignedWord.evalGroup] using
      sourceG1Generator_loop src dst i hloop
  have hUp :=
    ((Q.kStable_iff_word_kernel 1).mp
      (sourceH1ToG1_oneStable src dst))
      ({i} : Finset ι) (by simp)
      [PSTS.SignedLetter.pos i]
      (by simp [LabelWord.Uses]) hDown
  simpa [PSTS.SignedWord.evalGroup] using hUp

/-- The constructed source-shaped H1 is FINITE for finite
original vertices and finite labelled edges, and it is the
actual synchronized generated subgroup rather than the
whole product of two unrelated groups. -/
theorem finite_sourceH1
    (src dst : ι → V) :
    Finite (SourceH1 src dst) := by
  classical
  letI : Finite (sourceX1 src dst).transitionGroup :=
    (sourceX1 src dst).finite_transitionGroup
  exact finite_unarySynchronizedCover (sourceG1Generator src dst)

end ABO
end PSTSEPPA
