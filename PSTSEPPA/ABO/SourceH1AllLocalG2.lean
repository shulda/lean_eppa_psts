import PSTSEPPA.ABO.SourceX1ConcreteH1
import PSTSEPPA.ABO.AllLocalRankTwoCayleySkeletons
import PSTSEPPA.ABO.SynchronizedGeneratedGroup

/-!
# One actual finite source-graph G₂ over the explicitly constructed H₁

This connects two independently derived formal results:
1. The first group H₁ built literally from transpositions of
   the source graph's oriented edge endpoints, synchronized with
   their unary detector cyclic coordinates. The resulting H₁ is
   finite, generated, 2-retractable and 1-stable over source G₁.
2. The all-local rank-two stage construction: for every two-letter
   subalphabet A, and EVERY incomplete Cayley skeleton in H₁[A],
   take all three genuine rank-two augmented completed stage
   families, and synchronize their action over the original H₁.

Thus we construct ONE genuine finite group G₂, generated by the
original edge labels, with a surjective labelled 1-stable
quotient G₂ -> H₁, and with 2-retractability. The composite
G₂ -> G₁ is also a surjective 1-stable labelled quotient.

This construction does not yet prove Condition 5.2 or identify
all source Definition-5.3 H₁-covers with the chosen superfamily
of local stages. It is not a proof of the arbitrary-rank
reflecting-group induction or ordinary PSTS EPPA.
-/

namespace PSTSEPPA
namespace ABO

variable {ι V : Type*}
variable [Fintype ι] [DecidableEq ι]
variable [Fintype V] [DecidableEq V]

/-- The actual finite synchronously generated second-rank group
built from EVERY genuine local two-letter Cayley skeleton of
the source-shaped H₁. No arbitrary source-cover selection. -/
noncomputable abbrev sourceAllLocalG2
    (src dst : ι → V) :=
  allLocalRankTwoGroup
    (gen := sourceH1Generator src dst)
    (sourceH1_twoRetractable src dst)

/-- The distinguished positive edge generators of the constructed
G₂, using exactly the original input edge-label alphabet. -/
noncomputable abbrev sourceAllLocalG2Generator
    (src dst : ι → V) :
    ι → sourceAllLocalG2 src dst :=
  SynchronizedProduct.generator (sourceH1Generator src dst)
    (allLocalRankTwoStage
      (gen := sourceH1Generator src dst)
      (sourceH1_twoRetractable src dst)).transitionSubgroupGenerator

/-- The actual G₂ is generated by its paired original edge labels:
nothing else in the synchronized subgroup is postulated. -/
theorem sourceAllLocalG2Generator_isGenerated
    (src dst : ι → V) :
    IsGenerated (sourceAllLocalG2Generator src dst) := by
  exact SynchronizedProduct.generator_isGenerated
    (sourceH1Generator src dst)
    (allLocalRankTwoStage
      (gen := sourceH1Generator src dst)
      (sourceH1_twoRetractable src dst)).transitionSubgroupGenerator

/-- A genuine generator-preserving SURJECTIVE labelled group
quotient from G₂ to the concrete source-shaped H₁. -/
noncomputable def sourceAllLocalG2ToH1
    (src dst : ι → V) :
    LabelledGroupQuotient
      (sourceAllLocalG2Generator src dst)
      (sourceH1Generator src dst) :=
  allLocalRankTwoCoverQuotient
    (gen := sourceH1Generator src dst)
    (sourceH1_twoRetractable src dst)
    (sourceH1Generator_isGenerated src dst)

/-- This ACTUAL labelled quotient G₂ -> H₁ is 1-STABLE,
including original loops, inverse letters and noncommuting
distinct edge-transpositions. -/
theorem sourceAllLocalG2ToH1_oneStable
    (src dst : ι → V) :
    (sourceAllLocalG2ToH1 src dst).KStable 1 :=
  allLocalRankTwoCoverQuotient_oneStable
    (gen := sourceH1Generator src dst)
    (sourceH1_twoRetractable src dst)
    (sourceH1Generator_isGenerated src dst)

/-- The actual G₂ is 2-retractable, obtained using the
corrected rank descent from its true first projection.
Global retractability is never assumed for source H₁. -/
theorem sourceAllLocalG2_twoRetractable
    (src dst : ι → V) :
    KRetractable (sourceAllLocalG2Generator src dst) 2 :=
  allLocalRankTwoGroup_twoRetractable
    (gen := sourceH1Generator src dst)
    (sourceH1_twoRetractable src dst)
    (sourceH1Generator_isGenerated src dst)

/-- The composite surjective labelled quotient G₂ -> H₁ -> G₁
is a concrete group homomorphism, not a supplied abstract
transfer interface. -/
noncomputable def sourceAllLocalG2ToG1
    (src dst : ι → V) :
    LabelledGroupQuotient
      (sourceAllLocalG2Generator src dst)
      (sourceG1Generator src dst) :=
  (sourceAllLocalG2ToH1 src dst).comp
    (unarySynchronizedCoverQuotient
      (sourceG1Generator src dst)
      (sourceG1Generator_isGenerated src dst))

/-- The actual composite G₂ -> G₁ is also 1-stable.
Each intermediate quotient has been proved 1-stable on
ALL singleton-generated subgroups, so composition is legal. -/
theorem sourceAllLocalG2ToG1_oneStable
    (src dst : ι → V) :
    (sourceAllLocalG2ToG1 src dst).KStable 1 := by
  exact (sourceAllLocalG2ToH1 src dst).kStable_comp
    (unarySynchronizedCoverQuotient
      (sourceG1Generator src dst)
      (sourceG1Generator_isGenerated src dst))
    1 (sourceAllLocalG2ToH1_oneStable src dst)
    (sourceH1ToG1_oneStable src dst)

/-- For every finite original graph, this whole second-rank
synchronized group G₂ is actually FINITE, despite indexing
all locally possible incomplete signed skeletons and their
full augmented completed graph stages. -/
theorem finite_sourceAllLocalG2
    (src dst : ι → V) :
    Finite (sourceAllLocalG2 src dst) := by
  classical
  letI : Finite (SourceH1 src dst) := finite_sourceH1 src dst
  exact finite_allLocalRankTwoGroup
    (gen := sourceH1Generator src dst)
    (sourceH1_twoRetractable src dst)

end ABO
end PSTSEPPA
