import PSTSEPPA.ABO.ProperClusterRootTranslatedSubgroupEquiv
import PSTSEPPA.ABO.LocalCosetCayleySlice
import PSTSEPPA.ABO.ClusterCayleySkeleton

/-!
# ABO Theorem 4.5: ACTUAL ROOT-TRANSLATED proper B-cluster signed graph iso

The published proper B-cluster alternative is the ORIGINAL
left translate g*CL(Γ[B],P), with actual oriented signed
edge tokens. The previous theorem constructed exact dependent
vertex AND oriented edge equivalences with the corresponding
untranslated local generated H[C] cluster, for B⊆C.

We turn the TRANSLATED source set into its exact incomplete
signed Cayley skeleton, with precisely the indicated
translated old vertices and directed signed edges.
It does not add the missing Γ edges or merge component
tags. We then combine the genuine equivalences into a
labelled signed graph morphism, preserving:
* actual original source incidence;
* positive/negative signed labels;
* formal inversion of every signed edge;
* therefore true targets of both edge orientations.

Both maps are BIJECTIVE. Original Γ need neither be
globally retractable nor be generated by C.

This is the signed graph-theoretic ROOT-TRANSLATION
step for transporting concrete proper B-cluster shape
in the k-retractable source Theorem 4.5.
The full simultaneous cluster-property statement
remains a separate consequence of this geometric
isomorphism and tagged whole-component minimum transport.
-/

namespace PSTSEPPA
namespace ABO
namespace ClusterSpec

variable {ι Γ : Type*} [Fintype ι] [DecidableEq ι] [Group Γ]
variable {B : Finset ι}

/-- The source g-left-translated proper B-cluster, as a
GENUINE incomplete Γ-Cayley signed B-skeleton. Its vertices
and oriented signed edges are exactly the literal translated
sets defined in source Corollary 3.12 and Lemma 4.3. -/
noncomputable def rootTranslatedCayleySubgraph
    (gen : ι → Γ) (P : ClusterSpec B) (g : Γ) :
    CayleySubgraphSpec gen B where
  vertices := ClusterSpec.LeftTranslateSet g (P.VertexSet gen)
  edges := ClusterSpec.LeftTranslateEdgeSet g (P.EdgeSet gen)
  source_mem := by
    intro e he
    change g⁻¹ * e.1 ∈ P.VertexSet gen
    exact P.edge_source_mem gen he
  inv_mem := by
    intro e he
    change
      (g⁻¹ * (((cayleyGraph gen).inv e).1),
        (((cayleyGraph gen).inv e).2)) ∈ P.EdgeSet gen
    have hTranslateInv :
        (g⁻¹ * (((cayleyGraph gen).inv e).1),
          (((cayleyGraph gen).inv e).2)) =
        (cayleyGraph gen).inv (g⁻¹ * e.1, e.2) := by
      rcases e with ⟨x, s⟩
      cases s with
      | pos i =>
          change (g⁻¹ * (x * gen i), PSTS.SignedLetter.neg i) =
            ((g⁻¹ * x) * gen i, PSTS.SignedLetter.neg i)
          rw [mul_assoc]
      | neg i =>
          change (g⁻¹ * (x * (gen i)⁻¹), PSTS.SignedLetter.pos i) =
            ((g⁻¹ * x) * (gen i)⁻¹, PSTS.SignedLetter.pos i)
          rw [mul_assoc]
    rw [hTranslateInv]
    exact P.edge_inv_mem gen he
  label_mem := by
    intro e he
    obtain ⟨D,hDP,_hx,hl⟩ := he
    exact (P.proper D hDP).subset hl

/-- Concrete source-Γ translated proper-cluster vertex
set has the EXACT stipulated root-left-translation,
not a completion or a quotient by coordinates. -/
theorem rootTranslatedCayleySubgraph_vertices
    (gen : ι → Γ) (P : ClusterSpec B) (g : Γ) :
    (P.rootTranslatedCayleySubgraph gen g).vertices =
      ClusterSpec.LeftTranslateSet g (P.VertexSet gen) := rfl

/-- And its oriented signed edge set is LITERALLY
the source translated proper-cluster edge set. -/
theorem rootTranslatedCayleySubgraph_edges
    (gen : ι → Γ) (P : ClusterSpec B) (g : Γ) :
    (P.rootTranslatedCayleySubgraph gen g).edges =
      ClusterSpec.LeftTranslateEdgeSet g (P.EdgeSet gen) := rfl

/-- Actual signed labelled-graph transport from the
locally generated H[C] proper B-cluster into its exact
g-translated Γ-source cluster, for EVERY B⊆C.

No global Γ generation/retractability assumption.
No fake old edges. -/
noncomputable def localSignedTranslatedClusterHomOfParent
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) (g : Γ) :
    LabelledGraphHom
      (P.toLabelledGraph (trivialCompletionGenerator gen C))
      ((P.rootTranslatedCayleySubgraph gen g).toEGraph).toLabelledGraph where
  onVertex := P.localTranslatedVertexEquivOfParent gen C hBC g
  onEdge := P.localTranslatedEdgeEquivOfParent gen C hBC g
  map_source e := by
    apply Subtype.ext
    rfl
  map_inv e := by
    apply Subtype.ext
    have hs : signedBase e.1.2 ∈ C := by
      rcases e.2 with ⟨D,hDP,_,hl⟩
      exact ((P.proper D hDP).subset.trans hBC) hl
    change
      (g * (((cayleyGraph (trivialCompletionGenerator gen C)).inv e.1).1 : Γ),
        ((cayleyGraph (trivialCompletionGenerator gen C)).inv e.1).2) =
      (cayleyGraph gen).inv (g * (e.1.1 : Γ), e.1.2)
    exact localCayley_inv_leftTranslate gen C g e.1 hs
  map_label e := rfl

/-- Actual signed graph ISOMORPHISM on all vertices and
both original oriented edge token sets of a concrete
translated proper B-cluster. The map preserves source,
formal inverse, signed label and hence targets. -/
theorem localSignedTranslatedClusterHomOfParent_bijective
    (gen : ι → Γ) (P : ClusterSpec B)
    (C : Finset ι) (hBC : B ⊆ C) (g : Γ) :
    Function.Bijective
      (P.localSignedTranslatedClusterHomOfParent gen C hBC g).onVertex ∧
    Function.Bijective
      (P.localSignedTranslatedClusterHomOfParent gen C hBC g).onEdge :=
  ⟨(P.localTranslatedVertexEquivOfParent gen C hBC g).bijective,
   (P.localTranslatedEdgeEquivOfParent gen C hBC g).bijective⟩

end ClusterSpec
end ABO
end PSTSEPPA
