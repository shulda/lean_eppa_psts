import PSTSEPPA.ABO.LocalRankRetractableSubalphabet
import PSTSEPPA.ABO.LocalCosetCayleySlice

/-!
# Genuine proper cosets agree between a local subgroup and its ambient group

The corrected ABO source covers are intrinsic connected components
of an H1-Cayley skeleton, whereas the all-local first-rank
construction uses the ACTUAL subgroup H1[A] generated by its
two-letter parent alphabet. To transport their subsequent
proper-alphabet coset extensions, we must know that taking a
B-coset in H1[A], for B ⊆ A, agrees EXACTLY with the original
B-coset in H1 after taking underlying group coordinates.

We prove this without assuming retractability, finite Γ,
independent generators, or injectivity of generator labels.
Both directions use genuinely supported signed words, with
positive and negative labels retained. The same result gives
exact preservation/reflection of membership in translated
left B-cosets under the honest subgroup inclusion H1[A] ≤ H1.

This is the subgroup/coset component of the still-open
naturality theorem comparing source H1-cover coset extensions
with the local H1[A]-extensions in the finite G2 supercatalogue.
It does NOT itself identify all their tagged quotient vertices
or establish source Condition 5.2 and PSTS EPPA.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]

/-- For B⊆A, the ACTUAL subgroup of Γ[A] generated by the
trivially completed B-labelled generators consists exactly
of elements of Γ[A] whose ambient coordinates lie in Γ[B].

In particular the subgroup generated by B does not grow
when viewed inside Γ[A], and no B-relation is lost. -/
theorem mem_localGeneratedSubgroup_iff_ambient
    (gen : ι → Γ)
    (B A : Finset ι) (hBA : B ⊆ A)
    (x : generatedSubgroup gen A) :
    x ∈ generatedSubgroup (trivialCompletionGenerator gen A) B ↔
      (x : Γ) ∈ generatedSubgroup gen B := by
  constructor
  · intro hx
    obtain ⟨w, hw, heval⟩ :=
      exists_word_uses_eq_of_mem_generatedSubgroup
        (trivialCompletionGenerator gen A) B hx
    have hWA : LabelWord.Uses A w := hw.mono hBA
    have hcoe :
        ((PSTS.SignedWord.evalGroup
          (trivialCompletionGenerator gen A) w :
            generatedSubgroup gen A) : Γ) =
          PSTS.SignedWord.evalGroup gen w := by
      rw [coe_evalGroup_trivialCompletionGenerator,
        LabelWord.restrictTo_eq_self_of_uses A w hWA]
    have hxEq : (x : Γ) = PSTS.SignedWord.evalGroup gen w := by
      calc
        (x : Γ) =
            ((PSTS.SignedWord.evalGroup
              (trivialCompletionGenerator gen A) w :
                generatedSubgroup gen A) : Γ) := by rw [heval]
        _ = PSTS.SignedWord.evalGroup gen w := hcoe
    rw [hxEq]
    exact evalGroup_mem_generatedSubgroup_of_uses gen B hw
  · intro hx
    obtain ⟨w, hw, heval⟩ :=
      exists_word_uses_eq_of_mem_generatedSubgroup gen B hx
    have hWA : LabelWord.Uses A w := hw.mono hBA
    have hmem :
        PSTS.SignedWord.evalGroup
          (trivialCompletionGenerator gen A) w ∈
            generatedSubgroup (trivialCompletionGenerator gen A) B :=
      evalGroup_mem_generatedSubgroup_of_uses
        (trivialCompletionGenerator gen A) B hw
    have hval :
        PSTS.SignedWord.evalGroup
          (trivialCompletionGenerator gen A) w = x := by
      apply Subtype.ext
      calc
        ((PSTS.SignedWord.evalGroup
            (trivialCompletionGenerator gen A) w :
              generatedSubgroup gen A) : Γ) =
          PSTS.SignedWord.evalGroup gen w := by
            rw [coe_evalGroup_trivialCompletionGenerator,
              LabelWord.restrictTo_eq_self_of_uses A w hWA]
        _ = (x : Γ) := heval
    rwa [hval] at hmem

/-- Under the honest inclusion Γ[A] ≤ Γ, the left B-coset
of a selected root agrees EXACTLY with the ambient Γ
left B-coset, provided B⊆A. This preserves old/fresh
coset incidence rather than just a one-way containment. -/
theorem mem_localGeneratedLeftCoset_iff_ambient
    (gen : ι → Γ)
    (B A : Finset ι) (hBA : B ⊆ A)
    (g x : generatedSubgroup gen A) :
    x ∈ generatedLeftCoset
          (trivialCompletionGenerator gen A) B g ↔
      (x : Γ) ∈ generatedLeftCoset gen B (g : Γ) := by
  have h := mem_localGeneratedSubgroup_iff_ambient
    gen B A hBA (g⁻¹ * x)
  change g⁻¹ * x ∈
      generatedSubgroup (trivialCompletionGenerator gen A) B ↔
    (g : Γ)⁻¹ * (x : Γ) ∈ generatedSubgroup gen B
  simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using h

end ABO
end PSTSEPPA
