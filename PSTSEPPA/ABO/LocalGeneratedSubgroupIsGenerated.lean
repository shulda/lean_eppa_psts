import PSTSEPPA.ABO.KStableLocalGeneratedSubgroupQuotient
import PSTSEPPA.ABO.RankTwoLocalThreeFamilyCover

/-!
# True printed first-rank local groups have generated completed labels

The genuine general theorem
`isGenerated_trivialCompletionGenerator` was ALREADY
proved in `RankTwoLocalThreeFamilyCover.lean`.
Do not duplicate it under the same name.

Here we expose exactly its two source-facing applications,
which complete the local algebraic API for the finite
G₂=T(X₂^all) and H₁=T(Y₁) printed tower. For each A,
both true local groups G₂[A], H₁[A] are generated by
their original signed alphabet completed by 1 outside A.
For |A|≤2 these groups are already proved globally
retractable, and their quotient is 1-stable.

These are real subgroups, not ambient coordinate quotients
and not the final full G-coset extension embedding.
-/

namespace PSTSEPPA
namespace ABO

variable {ι V : Type*}
variable [Fintype ι] [DecidableEq ι]
variable [Fintype V] [DecidableEq V]

/-- The actual local printed G₂[A] group is generated by the
original completed letters. No global generation assumption. -/
theorem sourceLiteralY1X2AllLocal_isGenerated
    (src dst : ι → V) (A : Finset ι) :
    IsGenerated (trivialCompletionGenerator
      (sourceLiteralY1X2AllGenerator src dst) A) :=
  isGenerated_trivialCompletionGenerator
    (sourceLiteralY1X2AllGenerator src dst) A

/-- The true printed H₁[A] transition subgroup is generated by
the original completed letters, including negative and trivial
letters, and A=∅. -/
theorem sourceLiteralY1Local_isGenerated
    (src dst : ι → V) (A : Finset ι) :
    IsGenerated (trivialCompletionGenerator
      (sourceLiteralY1 src dst).transitionSubgroupGenerator A) :=
  isGenerated_trivialCompletionGenerator
    (sourceLiteralY1 src dst).transitionSubgroupGenerator A

/-- All real first-rank source G₂[A] local groups of rank ≤2
are BOTH actually generated AND fully retractable. -/
theorem sourceLiteralY1X2AllLocal_generated_retractable
    (src dst : ι → V) (A : Finset ι) (hA : A.card ≤ 2) :
    IsGenerated (trivialCompletionGenerator
      (sourceLiteralY1X2AllGenerator src dst) A) ∧
    Retractable (trivialCompletionGenerator
      (sourceLiteralY1X2AllGenerator src dst) A) :=
  ⟨sourceLiteralY1X2AllLocal_isGenerated src dst A,
    sourceLiteralY1X2AllLocal_retractable src dst A hA⟩

/-- The same generated/retractable result for true printed
H₁[A] local source transitions, without collapsing old tags. -/
theorem sourceLiteralY1Local_generated_retractable
    (src dst : ι → V) (A : Finset ι) (hA : A.card ≤ 2) :
    IsGenerated (trivialCompletionGenerator
      (sourceLiteralY1 src dst).transitionSubgroupGenerator A) ∧
    Retractable (trivialCompletionGenerator
      (sourceLiteralY1 src dst).transitionSubgroupGenerator A) :=
  ⟨sourceLiteralY1Local_isGenerated src dst A,
    sourceLiteralY1Local_retractable src dst A hA⟩

end ABO
end PSTSEPPA
