import PSTSEPPA.ABO.LocalRankRetractableSubalphabet
import PSTSEPPA.ABO.Lemma43RetractableWordDeletion
import PSTSEPPA.ABO.CosetConnectivity

/-!
# Source ABO local-subalphabet groups are generated and retractable

Corrected ABO Lemma 4.3 and Theorem 4.7 use group geometry
on the ACTUAL local group generated by a selected alphabet C,
not global retractability of the whole intermediate group H.

The accepted lemma `retractable_trivialCompletionGenerator_of_kRetractable`
already proves that for a k-retractable finite labelled group
and |C| <= k, the subgroup H[C], with labels outside C
acting as the identity, is globally RETRACTABLE.

We complete its algebraic API by showing the labelled family
`trivialCompletionGenerator gen C` really GENERATES
the subgroup H[C] itself, for every ambient group Γ and every
alphabet C. The proof uses the accepted source subalphabet
word representation and signed-word filtering, not any
unjustified generation property of ambient Γ.

Combining these two results gives the exact local group
hypotheses `IsGenerated` and `Retractable` required by
the Cayley-coset and component-tagged completion lemmas
used in the formalization of source Lemma 4.3.

This is an ALGEBRAIC localization result only. Transporting
the original source skeleton K or a higher-rank coset
extension to this local group with all signed old/fresh
edge tokens and old component tags unchanged remains
a separate source-specific geometric task.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ]

/-- Every element of the ACTUAL subgroup generated by C
is the evaluation of a signed word in the trivial-completed
labelled generator family, and that word can be chosen
with all its original letters IN C.

No ambient generation or retractability is needed. -/
theorem trivialCompletionGenerator_exists_word
    (gen : ι → Γ) (C : Finset ι)
    (x : generatedSubgroup gen C) :
    ∃ w : LabelWord ι,
      LabelWord.Uses C w ∧
      PSTS.SignedWord.evalGroup
        (trivialCompletionGenerator gen C) w = x := by
  obtain ⟨w, hwC, hEval⟩ :=
    exists_word_uses_eq_of_mem_generatedSubgroup
      gen C x.2
  refine ⟨w, hwC, ?_⟩
  apply Subtype.ext
  change
    ((PSTS.SignedWord.evalGroup
      (trivialCompletionGenerator gen C) w :
        generatedSubgroup gen C) : Γ) = x.1
  rw [coe_evalGroup_trivialCompletionGenerator,
    LabelWord.restrictTo_eq_self_of_uses C w hwC]
  exact hEval

/-- The completed local labelled family does generate
the WHOLE subgroup H[C]. This is the missing `IsGenerated`
companion to the accepted global-retractability
localization result. The proof holds even when the
ambient label family has trivial or repeated generators. -/
theorem isGenerated_trivialCompletionGenerator
    (gen : ι → Γ) (C : Finset ι) :
    IsGenerated (trivialCompletionGenerator gen C) := by
  let localGen := trivialCompletionGenerator gen C
  let H : Subgroup (generatedSubgroup gen C) :=
    Subgroup.closure (Set.range localGen)
  have hWord (w : LabelWord ι) :
      PSTS.SignedWord.evalGroup localGen w ∈ H := by
    induction w with
    | nil =>
        exact H.one_mem
    | cons s w ih =>
        rw [PSTS.SignedWord.evalGroup_cons]
        cases s with
        | pos i =>
            have hi : localGen i ∈ H :=
              Subgroup.subset_closure ⟨i, rfl⟩
            exact H.mul_mem hi ih
        | neg i =>
            have hi : localGen i ∈ H :=
              Subgroup.subset_closure ⟨i, rfl⟩
            exact H.mul_mem (H.inv_mem hi) ih
  change H = ⊤
  apply top_unique
  intro x _hx
  obtain ⟨w, _hwC, hwValue⟩ :=
    trivialCompletionGenerator_exists_word gen C x
  rw [← hwValue]
  exact hWord w

/-- Published ABO local-rank algebraic package:
k-retractability of the parent and |C|<=k imply that
the REAL generated subgroup H[C], labelled by all
generators with outside-C labels trivial, is both
generated by those labels and globally retractable.

This packages the two exact algebraic hypotheses
needed to instantiate generic signed Cayley and
tagged-coset theorems on H[C], without claiming the
original intermediate H itself is globally retractable. -/
theorem generated_and_retractable_local_subalphabet
    (gen : ι → Γ) (k : ℕ)
    (hret : KRetractable gen k)
    (C : Finset ι) (hC : C.card ≤ k) :
    IsGenerated (trivialCompletionGenerator gen C) ∧
    Retractable (trivialCompletionGenerator gen C) := by
  exact ⟨isGenerated_trivialCompletionGenerator gen C,
    retractable_trivialCompletionGenerator_of_kRetractable
      gen k hret C hC⟩

end ABO
end PSTSEPPA
