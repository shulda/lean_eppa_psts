import PSTSEPPA.ABO.StabilityRetractability
import PSTSEPPA.ABO.LocalRankRetractableSubalphabet

/-!
# ABO corrected Theorem 4.7: exact R1 local retractability bridge

The upward induction assumes a (k+1)-retractable DOWNSTAIRS
group H, and a k-stable labelled expansion G → H. The source
later uses retractability of G at rank |A| = k+1; this
implication is repair R1 of the published proof and cannot
be silently used without a derivation.

The original project already certified the FULL algebraic
implication `Q.kRetractable_of_kStable`. For use in the
source Γ[A]-rooted local stage, one needs a slightly more
concrete consequence:

* BOTH groups H[A] and G[A], for every |A| ≤ k+1, are
  globally generated by their A-generators (outside-A
  letters act as identity) and globally retractable;
* the k-stability hypothesis gives a genuine isomorphism
  on the subgroups for EVERY B ⊊ A, because |B|≤k.

These precisely justify applying original signed coset
extension APIs locally in the UPWARD stage, without
making the false stronger assumption that all of G
is globally retractable on the entire E alphabet.
No underlying old EGraph embeddedness, covers or
bridge-freeness is claimed here.

All edge cases k=0, empty B, and |A|=k+1 are covered.
No added axioms or sorry.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ Δ : Type*}
variable [Fintype ι] [DecidableEq ι]
variable [Group Γ] [Group Δ]
variable {genΓ : ι → Γ} {genΔ : ι → Δ}

namespace LabelledGroupQuotient

variable (Q : LabelledGroupQuotient genΓ genΔ)

/-- Repair R1 in EXACT source Γ[A] form:
if G→H is k-stable and H is (k+1)-retractable,
then every G[A] with |A|≤k+1 is retractable on
its local completed full label alphabet.

The source G need not be globally retractable
on all E labels. -/
theorem upwardLocalRetractable_domain
    (k : ℕ)
    (hStable : Q.KStable k)
    (hRetH : KRetractable genΔ (k+1))
    (A : Finset ι) (hA : A.card ≤ k+1) :
    Retractable (trivialCompletionGenerator genΓ A) := by
  have hRetG : KRetractable genΓ (k+1) :=
    Q.kRetractable_of_kStable k hStable hRetH
  exact retractable_trivialCompletionGenerator_of_kRetractable
    genΓ (k+1) hRetG A hA

/-- The H[A] stage is likewise retractable by
the actual source rank-(k+1) hypothesis. -/
theorem upwardLocalRetractable_target
    (k : ℕ)
    (hRetH : KRetractable genΔ (k+1))
    (A : Finset ι) (hA : A.card ≤ k+1) :
    Retractable (trivialCompletionGenerator genΔ A) :=
  retractable_trivialCompletionGenerator_of_kRetractable
    genΔ (k+1) hRetH A hA

/-- Source upward Theorem 4.7's proper constituent
labels all have CARDINALITY at most k. A k-stable
expansion is therefore stable on EVERY B⊊A,
not only for coatom B. -/
theorem upwardProperStable
    (k : ℕ) (hStable : Q.KStable k)
    (A : Finset ι) (hA : A.card ≤ k + 1) :
    ∀ (B : Finset ι), B ⊂ A → Q.StableAt B := by
  intro B hBA
  have hlt : B.card < A.card := Finset.card_lt_card hBA
  have hB : B.card ≤ k := by omega
  exact hStable B hB

/-- All core group-theoretic assumptions for the
source rank-(k+1) UPWARD stage: its two actual
generated/retractable local labelled groups and
stability on every selected proper constituent.
This is a consequence of the printed hypotheses,
not an additional assumption on G. -/
theorem upwardLocalGroupPackage
    (k : ℕ)
    (hStable : Q.KStable k)
    (hRetH : KRetractable genΔ (k+1))
    (A : Finset ι) (hA : A.card ≤ k+1) :
    IsGenerated (trivialCompletionGenerator genΓ A) ∧
    IsGenerated (trivialCompletionGenerator genΔ A) ∧
    Retractable (trivialCompletionGenerator genΓ A) ∧
    Retractable (trivialCompletionGenerator genΔ A) ∧
    (∀ B : Finset ι, B ⊂ A → Q.StableAt B) := by
  exact ⟨isGenerated_trivialCompletionGenerator genΓ A,
    isGenerated_trivialCompletionGenerator genΔ A,
    Q.upwardLocalRetractable_domain k hStable hRetH A hA,
    Q.upwardLocalRetractable_target k hRetH A hA,
    Q.upwardProperStable k hStable A hA⟩

end LabelledGroupQuotient
end ABO
end PSTSEPPA
