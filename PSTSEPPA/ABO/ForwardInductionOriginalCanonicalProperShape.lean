import PSTSEPPA.ABO.SignedBComponentShapeTransport
import PSTSEPPA.ABO.SourceCanonicalSignedForwardClusterProperty
import PSTSEPPA.ABO.ForwardInductionOriginalRootedMinimum

/-!
# ABO 4.5: true original rooted signed B-component canonical local cluster shape

The now certified global source Lemma 4.3 identifies each proper
signed B-component with a CANONICAL translated B-cluster (all real
vertices and both orientations of edge tokens). The original Γ
stage is not the same graph as its normalized local H[C] stage,
and Γ need not itself be retractable or generated by C.

This module explicitly transports the WHOLE canonical local proper
signed cluster shape across the TRUE bijective original/local
rooted EGraph map, using the generic signed component-shape
transport API. The result is a signed graph isomorphism FROM the
ORIGINAL component-tagged Γ-rooted quotient onto the canonical
H[C]-valued cluster. The further identification of this H[C] target
with the appropriately rooted and translated ORIGINAL Γ-Cayley
cluster remains a separate step.

A corollary uses the actual lower local bridge-free assumptions and
the true off-skeleton condition to obtain the full-local-coset OR
original-signed-proper-cluster alternative. Neither branch is
silently identified merely by equal ambient group coordinates.
-/

namespace PSTSEPPA
namespace ABO

variable {ι Γ : Type*}
variable [Fintype ι] [DecidableEq ι] [Group Γ] [Finite Γ]
variable {gen : ι → Γ} {A : Finset ι}

namespace CayleySubgraphSpec

variable (K : CayleySubgraphSpec gen A)

/-- The ORIGINAL Γ-rooted signed whole B-component is genuinely
isomorphic to the CANONICAL local H[C] translated proper B-cluster,
including actual vertices and oriented inverse/positive edge tokens.
The cluster carries the TRUE local core and proper constituent
alphabets; this does NOT yet identify its Γ-root translation. -/
def ArbitraryRankRootedOriginalCanonicalLocalProperSignedAlternative
    (C : Finset ι) (root : K.Vertex)
    (hadm : (K.intrinsicComponentLocalSlice C root).AdmissibleForCosetExtension)
    (hgen : IsGenerated (trivialCompletionGenerator gen C))
    (hret : Retractable (trivialCompletionGenerator gen C))
    (B : Finset ι)
    (u : (K.intrinsicComponentLocalSlice C root).MultiCosetVertex
      (allProperCosetFamily C) hadm hgen hret) : Prop :=
  ∃ (core : (K.intrinsicComponentLocalSlice C root).MultiCosetVertex
        (allProperCosetFamily C) hadm hgen hret)
    (hProper :
      ∀ t ∈ (K.intrinsicComponentLocalSlice C root).activeTaggedCoatoms
        hadm hgen hret B u,
        B ∩ (K.intrinsicComponentLocalSlice C root).properCosetTagAlphabet t ⊂ B),
    (∃ w : LabelWord ι, LabelWord.Uses B w ∧
      ((K.intrinsicComponentLocalSlice C root).multiCosetEGraph
        (allProperCosetFamily C) hadm hgen hret).Follows u w core) ∧
    (∀ t ∈ (K.intrinsicComponentLocalSlice C root).activeTaggedCoatoms
        hadm hgen hret B u,
      core ∈ (K.intrinsicComponentLocalSlice C root).properCosetTagSlice
        hadm hgen hret B u t) ∧
    ∃ f : LabelledGraphHom
      ((K.arbitraryRankRootedOriginalCompletedEGraph
        C root (allProperCosetFamily C) hadm hgen hret).BComponentEGraph
        B (K.arbitraryRankRootedLocalMultiCosetVertexEquiv
          C root (allProperCosetFamily C) hadm hgen hret u)).toLabelledGraph
      (((((K.intrinsicComponentLocalSlice C root).activeTaggedLowerClusterSpec
        hadm hgen hret B u hProper).rootTranslatedCayleySubgraph
          (trivialCompletionGenerator gen C)
          ((K.intrinsicComponentLocalSlice C root).multiCosetAmbientValue
            (allProperCosetFamily C) hadm hgen hret core)).toEGraph).toLabelledGraph),
      Function.Bijective f.onVertex ∧ Function.Bijective f.onEdge

/-- Source Γ-rooted canonical local proper cluster signed SHAPE
from the verified source H[C] canonical proper alternative:
transport the actual WHOLE signed B-component graph and both
oriented edge token classes through the genuine rooted quotient
isomorphism, then compose with the canonical local cluster iso. -/
theorem rootedOriginalProperSignedShape_of_localCanonical
    (C : Finset ι) (root : K.Vertex)
    (hadm : (K.intrinsicComponentLocalSlice C root).AdmissibleForCosetExtension)
    (hgen : IsGenerated (trivialCompletionGenerator gen C))
    (hret : Retractable (trivialCompletionGenerator gen C))
    (B : Finset ι)
    (u : (K.intrinsicComponentLocalSlice C root).MultiCosetVertex
      (allProperCosetFamily C) hadm hgen hret)
    (hAlt :
      (K.intrinsicComponentLocalSlice C root).HasCanonicalProperSignedBCosetAlternative
        hadm hgen hret B u) :
    K.ArbitraryRankRootedOriginalCanonicalLocalProperSignedAlternative
      C root hadm hgen hret B u := by
  let L := K.intrinsicComponentLocalSlice C root
  let P := allProperCosetFamily C
  obtain ⟨core, hProper, hReach, hCommon, f, hv, he⟩ := hAlt
  refine ⟨core, hProper, hReach, hCommon, ?_⟩
  let G := K.arbitraryRankRootedLocalCompletedEGraph
    C root P hadm hgen hret
  let H := K.arbitraryRankRootedOriginalCompletedEGraph
    C root P hadm hgen hret
  let t := (L.activeTaggedLowerClusterSpec
    hadm hgen hret B u hProper).rootTranslatedCayleySubgraph
      (trivialCompletionGenerator gen C)
      (L.multiCosetAmbientValue P hadm hgen hret core)
  have hIso :=
    K.arbitraryRankRootedCompletedEGraphHom_bijective
      C root P hadm hgen hret
  exact G.signedBComponent_shape_transport_of_bijective
    H
    (K.arbitraryRankRootedCompletedEGraphHom C root P hadm hgen hret)
    hIso.1 hIso.2 B u t.toEGraph.toLabelledGraph f hv he

/-- Source k-local forward SHAPE theorem in the ORIGINAL rooted
Γ graph: from lower H[C] bridge-free stages and original actual
off-skeleton status, either the local full B-coset alternative
holds or the ORIGINAL signed B-component has the canonical
local proper-cluster signed graph shape. The next gate translates
that proper H[C] cluster to its literal root-translated Γ target
and transports the full-coset alternative's original tags. -/
theorem sourceKLocal_originalSignedFullOrCanonicalLocalProper
    (hadm : K.AdmissibleForCosetExtension)
    (k : ℕ) (hk : KRetractable gen k)
    (C : Finset ι) (hCA : C ⊆ A) (hCk : C.card ≤ k)
    (hcard : 2 ≤ C.card)
    (root : K.Vertex)
    (hBridge :
      (K.intrinsicComponentLocalSlice C root).HasAllLowerRootedBridgeFree
        (K.sourceInductionLocalAdmissibility hadm C hCA root)
        (isGenerated_trivialCompletionGenerator gen C)
        (retractable_trivialCompletionGenerator_of_kRetractable
          gen k hk C hCk))
    (B : Finset ι)
    (hBP : B ∈ (allProperCosetFamily C).alphabets)
    (u : (K.intrinsicComponentLocalSlice C root).MultiCosetVertex
      (allProperCosetFamily C)
      (K.sourceInductionLocalAdmissibility hadm C hCA root)
      (isGenerated_trivialCompletionGenerator gen C)
      (retractable_trivialCompletionGenerator_of_kRetractable
        gen k hk C hCk))
    (hOff : K.ArbitraryRankRootedOriginalOffSkeleton
      C root (allProperCosetFamily C)
      (K.sourceInductionLocalAdmissibility hadm C hCA root)
      (isGenerated_trivialCompletionGenerator gen C)
      (retractable_trivialCompletionGenerator_of_kRetractable
        gen k hk C hCk)
      B
      (K.arbitraryRankRootedLocalMultiCosetVertexEquiv
        C root (allProperCosetFamily C)
        (K.sourceInductionLocalAdmissibility hadm C hCA root)
        (isGenerated_trivialCompletionGenerator gen C)
        (retractable_trivialCompletionGenerator_of_kRetractable
          gen k hk C hCk) u)) :
    (K.intrinsicComponentLocalSlice C root).HasFullSignedBCosetAlternative
      (K.sourceInductionLocalAdmissibility hadm C hCA root)
      (isGenerated_trivialCompletionGenerator gen C)
      (retractable_trivialCompletionGenerator_of_kRetractable
        gen k hk C hCk) B u ∨
    K.ArbitraryRankRootedOriginalCanonicalLocalProperSignedAlternative
      C root
      (K.sourceInductionLocalAdmissibility hadm C hCA root)
      (isGenerated_trivialCompletionGenerator gen C)
      (retractable_trivialCompletionGenerator_of_kRetractable
        gen k hk C hCk) B u := by
  let L := K.intrinsicComponentLocalSlice C root
  let hadmL := K.sourceInductionLocalAdmissibility hadm C hCA root
  let hgenL := isGenerated_trivialCompletionGenerator gen C
  let hretL := retractable_trivialCompletionGenerator_of_kRetractable
    gen k hk C hCk
  have hStdOff :=
    K.originalRootedOffSkeleton_implies_standardLocalOffSkeleton
      C root hadmL hgenL hretL B hBP u hOff
  have hCanonical :
      L.HasCanonicalExactSignedWholeClusterProperty
        hadmL hgenL hretL :=
    L.canonicalExactSignedWholeClusterProperty_of_lowerBridgeFree
      hadmL hgenL hretL hcard hBridge
  obtain ⟨_D, _d, _hMinimum, hShape, _core, _hReach,
      _hCoreSupported, _hCoreCommon⟩ :=
    hCanonical B hBP u hStdOff
  rcases hShape with hFull | hProper
  · exact Or.inl hFull
  · exact Or.inr
      (K.rootedOriginalProperSignedShape_of_localCanonical
        C root hadmL hgenL hretL B u hProper)

end CayleySubgraphSpec
end ABO
end PSTSEPPA
